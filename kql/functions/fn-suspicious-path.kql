// Function — suspicious file path check
// Returns true if a folder path is a known suspicious location for malware to write
// to or execute from — the shared predicate behind executables-in-suspicious-
// paths.kql, usable inline in any file or process query
//
// Parameters:
//   FolderPath : string — e.g. FolderPath from DeviceFileEvents, or
//                InitiatingProcessFolderPath from DeviceProcessEvents
//
// Covers: AppData\Local\Temp, AppData\Roaming, ProgramData, Users\Public,
// Windows\Temp — legitimate software installs to Program Files, not these paths
//
// Returns: bool
//
// Example call:
//   DeviceFileEvents
//   | where fn_suspicious_path(FolderPath)
//
// Ref: docs/scenarios/05-malicious-file/investigation.md

let fn_suspicious_path = (FolderPath: string) {
    FolderPath has_any (
        "AppData\\Local\\Temp", "AppData\\Roaming",
        "ProgramData", "Users\\Public", "Windows\\Temp")
};
// Example call
DeviceFileEvents
| where TimeGenerated > ago(24h)
| where ActionType == "FileCreated"
| where fn_suspicious_path(FolderPath)
| project TimeGenerated, DeviceName, FileName, FolderPath, SHA256
