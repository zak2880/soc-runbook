// Platform: Microsoft Sentinel
// Note: EmailEvents is a Defender XDR Advanced Hunting-only table — NOT exposed as
// a queryable Sentinel Log Analytics table, even with the Microsoft Defender XDR
// connector configured (see docs/reference/sentinel-vs-advanced-hunting.md, Section
// 2/3). This file is kept for structural parity with kql/xdr/email/ and will error
// with "table not found" in a real Sentinel workspace today.
// Email — mass recipient campaign detection
// Same sender delivering to many distinct recipients in a short window — a phishing
// or spam campaign indicator rather than routine one-to-one business email
// Ref: docs/scenarios/12-phishing-email/investigation.md

let lookback = 24h;
let window = 1h;
let recipient_threshold = 20;
EmailEvents
| where TimeGenerated > ago(lookback)
| summarize
    RecipientCount = dcount(RecipientEmailAddress),
    Recipients = make_set(RecipientEmailAddress, 10),
    Subjects = make_set(Subject, 5)
    by SenderFromAddress, bin(TimeGenerated, window)
| where RecipientCount >= recipient_threshold
| order by RecipientCount desc
