// Platform: Microsoft Sentinel
// Identity — persistence mechanisms created post-compromise (AuditLogs)
// A smart attacker doesn't just steal a session — they plant a way back in that
// survives a password reset, so a "credentials changed" remediation alone won't
// evict them
// Covers, all correlated to a suspicious sign-in time window:
//   - new authentication method registered on the account (attacker adds their own
//     phone number or authenticator so they can re-auth even after a password reset)
//   - new service principals / app registrations (a backdoor app with its own
//     credential, independent of any user account)
//   - directory role assignments (attacker grants the compromised account, or a
//     new one, Global Admin or another privileged role)
//   - guest account invitations (a new external identity with a foothold in the
//     tenant that doesn't show up in normal employee account reviews)
// AuditLogs is the Sentinel-native directory audit table (Azure AD / Entra ID
// connector) — OperationName values below are the standard Entra directory audit
// activity names
// Correlation window: 24h following the suspicious sign-in
// Ref: docs/scenarios/06-credential-compromise/investigation.md

let lookback = 7d;
let persistence_window = 24h;
let SuspiciousSignIns = SigninLogs
| where TimeGenerated > ago(lookback)
| where AuthenticationRequirement != "singleFactorAuthentication" or RiskLevelDuringSignIn != "none"
| project UserPrincipalName, SignInTime = TimeGenerated;
AuditLogs
| where TimeGenerated > ago(lookback)
| where OperationName in (
    "Add authentication method",
    "Add service principal",
    "Add application",
    "Add member to role",
    "Invite external user")
| extend InitiatedByUpn = tostring(InitiatedBy.user.userPrincipalName)
| join kind=inner SuspiciousSignIns on $left.InitiatedByUpn == $right.UserPrincipalName
| where TimeGenerated between (SignInTime .. (SignInTime + persistence_window))
| project TimeGenerated, InitiatedByUpn, OperationName, TargetResources,
    Result, SignInTime
| order by TimeGenerated desc

