// Platform: Microsoft Sentinel
// Identity — Entra ID MFA fatigue / MFA push bombing (SigninLogs)
// Attacker has valid credentials and hammers the user with MFA prompts hoping
// they approve one to make it stop
// ResultType 50074 = MFA required but not completed, 50076 = user MFA challenge
// required, 50079 = MFA registration required — all read as an interrupted/failed
// MFA prompt for this hunt
// Threshold: 5+ MFA prompts in 10 minutes — tune for your environment
// Ref: docs/scenarios/06-credential-compromise/investigation.md

let lookback = 24h;
let window = 10m;
let fatigue_threshold = 5;
SigninLogs
| where TimeGenerated > ago(lookback)
| where AuthenticationRequirement == "multiFactorAuthentication"
| where ResultType in ("50074", "50076", "50079")
| summarize
    MFAPrompts = count(),
    SourceIPs = make_set(IPAddress),
    Locations = make_set(Location)
    by UserPrincipalName, bin(TimeGenerated, window)
| where MFAPrompts >= fatigue_threshold
| order by MFAPrompts desc

