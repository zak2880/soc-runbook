// Platform: Microsoft Sentinel
// Identity hygiene — password reset events (AuditLogs)
// Distinguishes self-service resets (a user resetting their own password via SSPR)
// from admin-initiated resets (an admin or application resets someone else's
// password) — the two carry very different risk profiles. A user resetting their
// own password is routine; an admin account resetting many other accounts'
// passwords in a short window is a classic post-compromise move to lock the real
// owners out, or to reset a target account to a known password
// IsSelfService compares the initiator's UPN against the target account's UPN —
// true means the account reset its own password, false means someone/something
// else did it on the account's behalf
// Flags: volume anomalies (5+ resets by one initiator in an hour), resets of
// privileged accounts (cross-reference TargetUpn against your admin role list),
// resets performed outside business hours
// Ref: docs/scenarios/06-credential-compromise/investigation.md

let lookback = 24h;
let volume_threshold = 5;
let business_hours_start = 7;
let business_hours_end = 19;
AuditLogs
| where TimeGenerated > ago(lookback)
| where OperationName in ("Reset password", "Reset user password", "Change password")
| extend InitiatedByUpn = tostring(InitiatedBy.user.userPrincipalName)
| extend InitiatedByApp = tostring(InitiatedBy.app.displayName)
| mv-expand Target = TargetResources
| extend TargetUpn = tostring(Target.userPrincipalName)
| extend IsSelfService = InitiatedByUpn =~ TargetUpn
| extend HourUTC = hourofday(TimeGenerated)
| extend OutsideBusinessHours = HourUTC !between (business_hours_start .. business_hours_end)
| summarize
    ResetCount = count(),
    Targets = make_set(TargetUpn),
    AnyOutsideBusinessHours = max(OutsideBusinessHours)
    by InitiatedByUpn, InitiatedByApp, IsSelfService, bin(TimeGenerated, 1h)
| extend VolumeAnomaly = ResetCount >= volume_threshold
| order by ResetCount desc

// ─────────────────────────────────────────────────────────────
// INVESTIGATION NOTES — copy paste into ticket / incident report
// ─────────────────────────────────────────────────────────────
//
