// Platform: Microsoft Sentinel
// Identity hygiene — guest account invitations (AuditLogs)
// Every guest invitation creates a new external identity with a foothold in the
// tenant. Most are legitimate (a real partner, vendor, or contractor being brought
// in for a project) — the risk is in the outliers: an invitation to a domain nobody
// on the security team recognises, a burst of invitations from one account, or an
// invitation sent by an account that has no business inviting anyone
// known_partner_domains is a placeholder — populate it with the customer's actual
// approved partner/vendor domain list before relying on the NonStandardDomain flag;
// without it, every invitation looks "non-standard" and the flag is just noise
// Flags: invitations to domains outside known_partner_domains, bulk invitations
// from one initiator, invitations sent by accounts that don't normally invite
// guests (most tenants restrict this to certain roles — confirm the restriction is
// actually enforced rather than assuming it is)
// Ref: docs/scenarios/06-credential-compromise/investigation.md

let lookback = 24h;
let known_partner_domains = dynamic(["partner1.com", "partner2.com"]);   // replace with the customer's actual approved domains
let bulk_window = 1h;
let bulk_threshold = 5;
AuditLogs
| where TimeGenerated > ago(lookback)
| where OperationName == "Invite external user"
| extend InitiatedByUpn = tostring(InitiatedBy.user.userPrincipalName)
| mv-expand Target = TargetResources
| extend InvitedEmail = tostring(Target.userPrincipalName)
| extend InvitedDomain = tostring(split(InvitedEmail, "@")[-1])
| extend NonStandardDomain = InvitedDomain !in (known_partner_domains)
| summarize
    InviteCount = count(),
    InvitedEmails = make_set(InvitedEmail),
    Domains = make_set(InvitedDomain)
    by InitiatedByUpn, bin(TimeGenerated, bulk_window)
| extend BulkInvitations = InviteCount >= bulk_threshold
| order by InviteCount desc

// ─────────────────────────────────────────────────────────────
// INVESTIGATION NOTES — copy paste into ticket / incident report
// ─────────────────────────────────────────────────────────────
//
// audit-guest-invitations.kql — [date run: YYYY-MM-DD] — Analyst: [initials]
//
// Result: [ ] No guest invitations to non-standard domains or bulk invitations detected in the review window
//         [ ] Results found — see findings below
//
// Findings:
//   Inviting account:
//   Invited email(s) / domain(s):
//   Timeframe:
//   Notes:
//
// Conclusion:
//   [ ] No suspicious activity identified — guest invitation(s) confirmed as legitimate business need
//   [ ] Suspicious activity identified — escalating
//   [ ] False positive — reason:
//
