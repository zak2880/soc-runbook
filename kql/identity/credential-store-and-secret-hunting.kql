// Identity — credential store, password-manager and secret-file hunting
// Runs in: Defender XDR Advanced Hunting (also works in Sentinel when the table is streamed)
// MITRE: T1555.004, T1555.005, T1552.001, T1552.002, T1552.004, T1552.006
// Covers: Windows Credential Manager enumeration, password-manager vault files, passwords searched for in files
// (findstr, GPP cpassword, unattend.xml), cloud/dev tokens and private keys, remote-access client saved
// credentials (RDCMan, mRemoteNG, WinSCP, PuTTY, FileZilla) and cloud CLI access-token requests
// A hit is a reason to look, not a verdict: admins and backup tools touch these paths too
// Replace HOSTNAME with the short device name (e.g. PC01); startswith matches the FQDN, case-insensitive
// Remove the device filter to hunt estate-wide
// Ref: docs/scenarios/06-credential-compromise/investigation.md, docs/reference/common-false-positives.md

// REPLACE: incident time (T0, UTC) on the next line before running
let T0 = datetime(PASTE_TIME_UTC);
DeviceProcessEvents
| where Timestamp between ((T0 - 24h) .. (T0 + 24h))
| where DeviceName startswith "HOSTNAME"
| extend Hit = case(
    ProcessCommandLine has_any ("cmdkey /list", "vaultcmd", "keymgr.dll", "Get-StoredCredential", "Get-VaultCredential", "PasswordVault", "CredEnumerate"),
        "Windows Credential Manager",
    ProcessCommandLine has_any (".kdbx", "KeePass", "keepass.config"),
        "Password-manager vault file",
    (ProcessCommandLine has_any ("findstr", "Select-String") and ProcessCommandLine has_any ("password", "passw", "pwd", "cpassword"))
        or ProcessCommandLine has_any ("unattend.xml", "sysprep.xml", "Groups.xml", "cpassword")
        or (ProcessCommandLine has "reg" and ProcessCommandLine has "/f password"),
        "Passwords searched for in files or registry",
    ProcessCommandLine has_any (".git-credentials", ".aws\\credentials", "id_rsa", "id_ed25519", "azureProfile.json", "accessTokens.json",
        "msal_token_cache", ".kube\\config", ".docker\\config.json", "credentials.db", "access_tokens.db"),
        "Cloud / dev tokens and private keys",
    ProcessCommandLine has_any ("rdcman.settings", "confCons.xml", "WinSCP.ini", "sitemanager.xml", "recentservers.xml", "SimonTatham\\PuTTY"),
        "Remote-access client saved credentials",
    ProcessCommandLine has_any ("get-access-token", "Get-AzAccessToken", "Get-MsalToken", "Get-GraphToken"),
        "Cloud CLI access-token request",
    "")
| where Hit != ""
| project Timestamp, DeviceName, AccountName, Category = Hit,
    FileName, ProcessCommandLine, InitiatingProcessFileName
| order by Timestamp asc
