// Identity — mass email access or forwarding following account compromise
// Once an attacker has a live session they read, export, or forward mail to stage
// the follow-on fraud (invoice redirection, further phishing from a trusted account)
// Covers: unusual volume of MailItemsAccessed operations, external forwarding rules
// being enabled (not just created — see entra-post-compromise-mailbox-rules.kql for
// creation events), eDiscovery searches run by a non-admin account, and mail export
// operations
// The EmailEvents version additionally covers messages forwarded externally,
// messages with suspicious attachments (by SHA256 or file type), and URLs clicked
// from the compromised account's received mail
// MailItemsAccessed volume threshold: 50+ in 1 hour is well above normal interactive
// use and typically indicates a script pulling the mailbox via Graph/EWS
// Three versions below, in increasing order of licence requirement — pick the one
// your tenant has. Ref: docs/scenarios/06-credential-compromise/investigation.md,
// docs/scenarios/12-phishing-email/investigation.md

// ============================================================
// Version 1 — CloudAppEvents
// Table   : CloudAppEvents — Defender for Cloud Apps activity log
// Licence : Defender for Cloud Apps (MDCA), Microsoft 365 E5 or E3 + add-on
// Access  : Defender XDR Advanced Hunting only — not a Sentinel-native table
// Limits  : MailItemsAccessed is a mailbox-audit-derived signal — requires
//           mailbox auditing enabled; eDiscovery and export activity require the
//           Purview app connector, which many MDCA deployments don't enable
// ============================================================
CloudAppEvents
| where TimeGenerated > ago(24h)
| where ActionType in ("MailItemsAccessed", "Set-Mailbox", "New-ComplianceSearch",
    "New-ComplianceSearchAction", "Search-Mailbox")
| summarize
    AccessCount = countif(ActionType == "MailItemsAccessed"),
    ExternalForwardEnabled = countif(ActionType == "Set-Mailbox" and RawEventData has "ForwardingSmtpAddress"),
    eDiscoverySearches = countif(ActionType in ("New-ComplianceSearch", "New-ComplianceSearchAction")),
    MailExports = countif(ActionType == "Search-Mailbox")
    by AccountId, bin(TimeGenerated, 1h)
| where AccessCount > 50 or ExternalForwardEnabled > 0 or eDiscoverySearches > 0 or MailExports > 0
| order by AccessCount desc

// ─────────────────────────────────────────────────────────────
// INVESTIGATION NOTES — CloudAppEvents version
// ─────────────────────────────────────────────────────────────
//
// entra-post-compromise-email-exfil.kql (CloudAppEvents) — [date run: YYYY-MM-DD] — Analyst: [initials]
//
// Result: [ ] No results — no high-volume mailbox access, external-forwarding enablement, eDiscovery searches, or mail export operations detected
//         [ ] Results found — see findings below
//
// Findings:
//   Account(s):
//   IP address(es):
//   Location(s):
//   Timeframe:
//   Notes:
//
// Conclusion:
//   [ ] No suspicious activity identified — mailbox access volume and export/eDiscovery activity for this account appear normal (CloudAppEvents)
//   [ ] Suspicious activity identified — escalating
//   [ ] False positive — reason:
//
// ─────────────────────────────────────────────────────────────
;
// ============================================================
// Version 2 — OfficeActivity
// Table   : OfficeActivity — Exchange / Purview unified audit log
// Licence : Microsoft 365 E3+ with unified audit logging enabled; eDiscovery
//           actions need Purview eDiscovery (Standard is E3, Premium is E5)
// Access  : Sentinel only, via the "Office 365" data connector — does NOT exist
//           in Defender XDR Advanced Hunting
// Limits  : MailItemsAccessed logging requires mailbox auditing enabled on the
//           target mailbox; high-volume MailItemsAccessed events can be throttled
//           or batched by Exchange under heavy load, so treat the count as a
//           floor, not an exact figure
// ============================================================
OfficeActivity
| where TimeGenerated > ago(24h)
| where Operation in ("MailItemsAccessed", "Set-Mailbox", "New-ComplianceSearch",
    "New-ComplianceSearchAction", "Search-Mailbox")
| summarize
    AccessCount = countif(Operation == "MailItemsAccessed"),
    ExternalForwardEnabled = countif(Operation == "Set-Mailbox" and AuditData has "ForwardingSmtpAddress"),
    eDiscoverySearches = countif(Operation in ("New-ComplianceSearch", "New-ComplianceSearchAction")),
    MailExports = countif(Operation == "Search-Mailbox"),
    RunByNonAdmin = countif(Operation in ("New-ComplianceSearch", "Search-Mailbox") and UserType != "Admin")
    by UserId, bin(TimeGenerated, 1h)
| where AccessCount > 50 or ExternalForwardEnabled > 0 or eDiscoverySearches > 0
    or MailExports > 0 or RunByNonAdmin > 0
| order by AccessCount desc

// ─────────────────────────────────────────────────────────────
// INVESTIGATION NOTES — OfficeActivity version
// ─────────────────────────────────────────────────────────────
//
// entra-post-compromise-email-exfil.kql (OfficeActivity) — [date run: YYYY-MM-DD] — Analyst: [initials]
//
// Result: [ ] No results — no high-volume mailbox access, external-forwarding enablement, non-admin eDiscovery searches, or mail export operations detected
//         [ ] Results found — see findings below
//
// Findings:
//   Account(s):
//   IP address(es):
//   Location(s):
//   Timeframe:
//   Notes:
//
// Conclusion:
//   [ ] No suspicious activity identified — mailbox access volume and export/eDiscovery activity for this account appear normal (OfficeActivity)
//   [ ] Suspicious activity identified — escalating
//   [ ] False positive — reason:
//
// ─────────────────────────────────────────────────────────────
;
// ============================================================
// Version 3 — EmailEvents + EmailAttachmentInfo + EmailUrlInfo
// Table   : EmailEvents joined with EmailAttachmentInfo and EmailUrlInfo
// Licence : Defender for Office 365 Plan 1 (attachment/URL detonation needs
//           Plan 2 for full verdicts, but the raw events exist on Plan 1)
// Access  : Defender XDR Advanced Hunting only — EmailEvents does not flow to
//           Sentinel as a native table; bring MDO alerts into Sentinel via the
//           Microsoft Defender XDR connector instead of querying this directly
//           from Log Analytics
// Limits  : Only covers mail flowing through Exchange Online Protection / MDO —
//           does not see mail already delivered before MDO was provisioned, and
//           attachment SHA256/verdict fields depend on Safe Attachments being on
// ============================================================
let CompromisedAccount = "USERNAME@example.com";   // replace before running
let CompromiseWindowStart = datetime(2024-01-01T00:00:00Z);   // replace with the compromise start time
let target_hash = "PASTE_HASH_HERE";   // replace with a known-bad SHA256 if hunting a specific attachment
let ForwardedExternally = EmailEvents
| where TimeGenerated > CompromiseWindowStart
| where SenderFromAddress =~ CompromisedAccount
| where EmailDirection == "Outbound"
| where DetectionMethods has "Forward" or Subject startswith "FW:"
| project TimeGenerated, NetworkMessageId, RecipientEmailAddress, Subject;
let SuspiciousAttachments = EmailAttachmentInfo
| where TimeGenerated > CompromiseWindowStart
| join kind=inner (
    EmailEvents
    | where TimeGenerated > CompromiseWindowStart
    | where RecipientEmailAddress =~ CompromisedAccount
) on NetworkMessageId
| where FileType in ("exe", "dll", "js", "vbs", "hta", "iso", "lnk")
    or SHA256 == target_hash
| project TimeGenerated, NetworkMessageId, FileName, FileType, SHA256, MalwareFamily;
let ClickedUrls = EmailUrlInfo
| join kind=inner (
    EmailEvents
    | where TimeGenerated > CompromiseWindowStart
    | where RecipientEmailAddress =~ CompromisedAccount
) on NetworkMessageId
| join kind=inner (
    UrlClickEvents
    | where TimeGenerated > CompromiseWindowStart
    | where AccountUpn =~ CompromisedAccount
) on Url
| project TimeGenerated, NetworkMessageId, Url, IsClickedThrough, ActionType;
union
    (ForwardedExternally | extend Reason = "Message forwarded externally"),
    (SuspiciousAttachments | extend Reason = "Suspicious attachment in received mail"),
    (ClickedUrls | extend Reason = "URL clicked from compromised account's mail")
| order by TimeGenerated desc

// ─────────────────────────────────────────────────────────────
// INVESTIGATION NOTES — EmailEvents version
// ─────────────────────────────────────────────────────────────
//
// entra-post-compromise-email-exfil.kql (EmailEvents) — [date run: YYYY-MM-DD] — Analyst: [initials]
//
// Result: [ ] No results — no externally forwarded messages, suspicious attachments, or malicious URL clicks identified in the compromised account's mail
//         [ ] Results found — see findings below
//
// Findings:
//   Account(s):
//   IP address(es):
//   Location(s):
//   Timeframe:
//   Notes:
//
// Conclusion:
//   [ ] No suspicious activity identified — the compromised account's mail shows no forwarding, malicious attachments, or malicious URL clicks (EmailEvents)
//   [ ] Suspicious activity identified — escalating
//   [ ] False positive — reason:
//
// ─────────────────────────────────────────────────────────────
