// Identity — browser credential and session cookie theft (infostealer behaviour)
// Runs in: Defender XDR Advanced Hunting (also works in Sentinel when the table is streamed)
// MITRE: T1555.003, T1539
// Covers: non-browser processes copying browser credential/cookie stores, command lines that reference those
// stores, known browser-stealer tooling, and headless browsers started with a remote debugging port
// (a common way to lift session cookies without touching the encrypted store)
// Stolen session cookies bypass MFA: if this hits, revoke the user's sessions as well as resetting the password
// Replace HOSTNAME with the short device name (e.g. PC01); startswith matches the FQDN, case-insensitive
// Remove the device filters to hunt estate-wide
// VERIFY: DeviceFileEvents records creates, modifies, renames and deletes but not plain reads, so a stealer
// that reads the store in place leaves no file event; the process rows are the stronger signal
// Ref: docs/scenarios/06-credential-compromise/investigation.md, docs/reference/common-false-positives.md

// REPLACE: incident time (T0, UTC) on the next line before running
let T0 = datetime(PASTE_TIME_UTC);
let Browsers = dynamic(["chrome.exe", "msedge.exe", "firefox.exe", "brave.exe", "opera.exe", "iexplore.exe"]);
let StoreNames = dynamic(["Login Data", "Cookies", "Web Data", "Local State", "logins.json", "key4.db", "cookies.sqlite"]);
let ProcessHits = DeviceProcessEvents
| where Timestamp between ((T0 - 24h) .. (T0 + 24h))
| where DeviceName startswith "HOSTNAME"
| extend Hit = case(
    ProcessCommandLine has_any ("SharpChrome", "SharpDPAPI", "HackBrowserData", "hack-browser-data", "BrowserGhost", "ChromePass",
        "WebBrowserPassView", "SharpCookieMonster", "dpapi::chrome", "LaZagne"),
        "Known browser-stealer tooling",
    FileName in~ (Browsers) and ProcessCommandLine has "remote-debugging-port",
        "Browser started with remote debugging port",
    FileName !in~ (Browsers) and ProcessCommandLine has_any (StoreNames) and ProcessCommandLine has_any ("User Data", "Profiles", "Mozilla"),
        "Command line references browser credential store",
    "")
| where Hit != ""
| project Timestamp, Source = "Process", Category = Hit, DeviceName, AccountName,
    Process = FileName, Detail = ProcessCommandLine, Parent = InitiatingProcessFileName;
let FileHits = DeviceFileEvents
| where Timestamp between ((T0 - 24h) .. (T0 + 24h))
| where DeviceName startswith "HOSTNAME"
| where ActionType in ("FileCreated", "FileRenamed")
| where FileName in~ (StoreNames)
| where InitiatingProcessFileName !in~ (Browsers)
| project Timestamp, Source = "File", Category = "Non-browser process created a browser store file",
    DeviceName, AccountName = InitiatingProcessAccountName, Process = InitiatingProcessFileName,
    Detail = strcat(FolderPath, "\\", FileName, " | ", InitiatingProcessCommandLine),
    Parent = InitiatingProcessParentFileName;
union ProcessHits, FileHits
| order by Timestamp asc
