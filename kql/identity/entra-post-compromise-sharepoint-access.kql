// Identity — bulk SharePoint/OneDrive file access or download post-compromise
// Once an attacker has a live session, SharePoint/OneDrive is the next-easiest place
// to stage data for exfiltration — no malware needed, just a browser or Graph calls
// Flags accounts that in the last 24h:
//   - accessed 3x+ more files than their own 30-day daily baseline
//   - accessed files outside their normal working hours (07:00-19:00 UTC baseline —
//     adjust for your customer timezone)
//   - shared a file externally (anonymous link or specific external recipient)
// Baseline is per-account, not estate-wide — a power user with a naturally high
// file-access volume won't false-positive against a low estate-wide threshold
// Ref: docs/scenarios/06-credential-compromise/investigation.md

// ============================================================
// Version 1 — CloudAppEvents
// Table   : CloudAppEvents — Defender for Cloud Apps activity log
// Licence : Defender for Cloud Apps (MDCA), Microsoft 365 E5 or E3 + add-on
// Access  : Defender XDR Advanced Hunting only — not a Sentinel-native table
// Limits  : Requires the SharePoint/OneDrive app connector enabled in MDCA;
//           external sharing detection depends on ActionType naming staying
//           consistent, which has changed across MDCA schema versions
// ============================================================
let Baseline = CloudAppEvents
| where TimeGenerated between (ago(37d) .. ago(7d))
| where ActionType in ("FileAccessed", "FileDownloaded", "FilePreviewed")
| summarize DailyAvg = count() / 30.0 by AccountId;
let ExternalShares = CloudAppEvents
| where TimeGenerated > ago(24h)
| where ActionType in ("AnonymousLinkCreated", "SharingInvitationCreated", "SharingSet")
| summarize ExternalShareCount = count() by AccountId;
CloudAppEvents
| where TimeGenerated > ago(24h)
| where ActionType in ("FileAccessed", "FileDownloaded", "FilePreviewed")
| extend HourUTC = hourofday(TimeGenerated)
| summarize
    AccessCount = count(),
    OutOfHoursCount = countif(HourUTC !between (7 .. 19))
    by AccountId
| join kind=leftouter Baseline on AccountId
| join kind=leftouter ExternalShares on AccountId
| extend DailyAvg = coalesce(DailyAvg, 1.0), ExternalShareCount = coalesce(ExternalShareCount, 0)
| extend AboveBaseline = AccessCount > (DailyAvg * 3)
| where AboveBaseline or OutOfHoursCount > 0 or ExternalShareCount > 0
| project AccountId, AccessCount, DailyAvg, OutOfHoursCount, ExternalShareCount
| order by AccessCount desc

// ─────────────────────────────────────────────────────────────
// INVESTIGATION NOTES — CloudAppEvents version
// ─────────────────────────────────────────────────────────────
//
// entra-post-compromise-sharepoint-access.kql (CloudAppEvents) — [date run: YYYY-MM-DD] — Analyst: [initials]
//
// Result: [ ] No results — no file access above the account's 30-day baseline, off-hours access, or external file sharing detected
//         [ ] Results found — see findings below
//
// Findings:
//   Account(s):
//   IP address(es):
//   Location(s):
//   Timeframe:
//   Notes:
//
// Conclusion:
//   [ ] No suspicious activity identified — SharePoint/OneDrive access volume and sharing activity for this account appear normal against baseline (CloudAppEvents)
//   [ ] Suspicious activity identified — escalating
//   [ ] False positive — reason:
//
// ─────────────────────────────────────────────────────────────
;
// ============================================================
// Version 2 — OfficeActivity
// Table   : OfficeActivity — SharePoint Online / OneDrive audit log
// Licence : Microsoft 365 E3+ with unified audit logging enabled
// Access  : Sentinel only, via the "Office 365" data connector — does NOT exist
//           in Defender XDR Advanced Hunting
// Limits  : SharePoint file-access auditing must be enabled at the tenant level
//           (SPO audit logging is on by default in modern tenants but check
//           older ones); Operation names below are the standard SPO audit set
// ============================================================
let Baseline = OfficeActivity
| where TimeGenerated between (ago(37d) .. ago(7d))
| where RecordType == "SharePointFileOperation"
| where Operation in ("FileAccessed", "FileDownloaded", "FilePreviewed")
| summarize DailyAvg = count() / 30.0 by UserId;
let ExternalShares = OfficeActivity
| where TimeGenerated > ago(24h)
| where RecordType == "SharePointSharingOperation"
| where Operation in ("AnonymousLinkCreated", "SharingInvitationCreated", "SharingSet")
| summarize ExternalShareCount = count() by UserId;
OfficeActivity
| where TimeGenerated > ago(24h)
| where RecordType == "SharePointFileOperation"
| where Operation in ("FileAccessed", "FileDownloaded", "FilePreviewed")
| extend HourUTC = hourofday(TimeGenerated)
| summarize
    AccessCount = count(),
    OutOfHoursCount = countif(HourUTC !between (7 .. 19))
    by UserId
| join kind=leftouter Baseline on UserId
| join kind=leftouter ExternalShares on UserId
| extend DailyAvg = coalesce(DailyAvg, 1.0), ExternalShareCount = coalesce(ExternalShareCount, 0)
| extend AboveBaseline = AccessCount > (DailyAvg * 3)
| where AboveBaseline or OutOfHoursCount > 0 or ExternalShareCount > 0
| project UserId, AccessCount, DailyAvg, OutOfHoursCount, ExternalShareCount
| order by AccessCount desc

