// Identity — suspicious OAuth app consent grants following a compromised sign-in
// Attackers who've phished a session (device code, AiTM) often register or consent to
// a malicious OAuth app instead of setting up mailbox rules — it survives a password
// reset and doesn't need repeated interactive sign-in
// Covers: mail.read, files.readwrite, offline_access scope grants, and any admin
// consent (ConsentType == AllPrincipals) performed by an account that isn't an admin
// Correlation window: consent granted within 1 hour of a suspicious sign-in for the
// same account — feed AccountUpn/UserId and SignInTime from
// entra-device-code-auth-flow.kql, entra-aitm-session-anomalies.kql, or
// entra-impossible-travel.kql
// Two versions below — pick the one that matches your tenant's licensing. Both cover
// the same detection logic against differently shaped source data.
// Ref: docs/scenarios/06-credential-compromise/investigation.md, docs/scenarios/12-phishing-email/investigation.md

// ============================================================
// Version 1 — CloudAppEvents
// Table   : CloudAppEvents — Defender for Cloud Apps activity log
// Licence : Defender for Cloud Apps (MDCA), included in Microsoft 365 E5 or as a
//           standalone add-on to E3
// Access  : Defender XDR Advanced Hunting only — not queryable from Sentinel Log
//           Analytics directly (MDCA does not write to a Sentinel-native table;
//           bring alerts in via the Microsoft Defender XDR connector instead)
// Limits  : Only covers apps/activity MDCA has visibility into via the Office 365
//           app connector — OAuth consent events specifically require the
//           Cloud App Security "App governance" add-on to be enabled
// ============================================================
let SuspiciousSignIns = AADSignInEventsBeta
| where TimeGenerated > ago(7d)
| where AuthenticationProtocol == "deviceCode" or RiskLevelDuringSignIn != "none"
| project AccountUpn, SignInTime = TimeGenerated;
CloudAppEvents
| where TimeGenerated > ago(7d)
| where ActionType in ("Consent to application.", "Add OAuth2PermissionGrant.")
| extend RawData = parse_json(RawEventData)
| extend Scopes = tostring(RawData.ModifiedProperties), ConsentType = tostring(RawData.ConsentType)
| where Scopes has_any ("Mail.Read", "Files.ReadWrite", "offline_access")
    or ConsentType == "AllPrincipals"
| join kind=inner SuspiciousSignIns on $left.AccountId == $right.AccountUpn
| where TimeGenerated between (SignInTime .. (SignInTime + 1h))
| where ConsentType != "AllPrincipals" or IsAdminOperation == false
| project TimeGenerated, AccountId, Application, ActionType,
    Scopes, ConsentType, IsAdminOperation, IPAddress, SignInTime
| order by TimeGenerated desc

// ─────────────────────────────────────────────────────────────
// INVESTIGATION NOTES — CloudAppEvents version
// ─────────────────────────────────────────────────────────────
//
// entra-post-compromise-oauth-grants.kql (CloudAppEvents) — [date run: YYYY-MM-DD] — Analyst: [initials]
//
// Result: [ ] No results — no suspicious OAuth consent grants (mail.read, files.readwrite, offline_access, or non-admin admin consent) detected within 1h of the suspicious sign-in
//         [ ] Results found — see findings below
//
// Findings:
//   Account(s):
//   IP address(es):
//   Location(s):
//   Timeframe:
//   Notes:
//
// Conclusion:
//   [ ] No suspicious activity identified — OAuth consent activity for this account in the post-sign-in window appears clean (CloudAppEvents)
//   [ ] Suspicious activity identified — escalating
//   [ ] False positive — reason:
//
// ─────────────────────────────────────────────────────────────
;
// ============================================================
// Version 2 — OfficeActivity
// Table   : OfficeActivity — unified Office 365 / Azure AD audit log
// Licence : Office 365 / Microsoft 365 E3 or above with unified audit logging
//           enabled (Purview compliance portal)
// Access  : Sentinel only, via the "Office 365" data connector — this table does
//           NOT exist in Defender XDR Advanced Hunting
// Limits  : AAD directory events (app consent) only appear here if Azure AD audit
//           logs have been configured to flow into the unified audit log; typical
//           ingestion delay is 15 minutes to a few hours; OperationName strings
//           are undocumented and can change between tenant configurations
// ============================================================
let SuspiciousSignIns = SigninLogs
| where TimeGenerated > ago(7d)
| where AuthenticationRequirement != "singleFactorAuthentication" or RiskLevelDuringSignIn != "none"
| project UserPrincipalName, SignInTime = TimeGenerated;
OfficeActivity
| where TimeGenerated > ago(7d)
| where Operation in ("Consent to application.", "Add app role assignment grant to user.", "Add delegated permission grant.")
| extend AuditParsed = parse_json(AuditData)
| extend Scopes = tostring(AuditParsed.ModifiedProperties), ConsentType = tostring(AuditParsed.ConsentType)
| where Scopes has_any ("Mail.Read", "Files.ReadWrite", "offline_access")
    or ConsentType == "AllPrincipals"
| join kind=inner SuspiciousSignIns on $left.UserId == $right.UserPrincipalName
| where TimeGenerated between (SignInTime .. (SignInTime + 1h))
| where ConsentType != "AllPrincipals" or tostring(AuditParsed.ActorContextId) !has "admin"
| project TimeGenerated, UserId, Operation, Scopes, ConsentType,
    ClientIP, SignInTime
| order by TimeGenerated desc

