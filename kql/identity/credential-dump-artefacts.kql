// Identity — credential-dump techniques and artefacts not covered by the credential sweep
// Runs in: Defender XDR Advanced Hunting (also works in Sentinel when the table is streamed)
// MITRE: T1003.001, T1003.002, T1003.003
// Covers: lsass dumped via comsvcs MiniDump / procdump / createdump / dumping tools, NTDS.dit extraction via
// ntdsutil IFM, esentutl, diskshadow and HarddiskVolumeShadowCopy copies, and the files these leave behind
// (lsass.dmp, ntds.dit outside the NTDS folder, SAM/SYSTEM/SECURITY hive copies, IFM folders, .dmp in user-writable paths)
// Complements credential-access-sweep.kql (Mimikatz keywords, reg save, Kerberoasting) and
// lsass-access-credential-dump.kql (OpenProcess on lsass). Any hit = escalate immediately
// Replace HOSTNAME with the short device name (e.g. PC01); startswith matches the FQDN, case-insensitive
// Remove the device filters to hunt estate-wide
// VERIFY: AV may delete the dump before the file event is recorded; the process rows still show the attempt
// Tool names and the shadow-copy device path are matched with contains / regex, not has: has only matches whole
// terms, so has "procdump" misses procdump64.exe and has "HarddiskVolumeShadowCopy" misses HarddiskVolumeShadowCopy1
// Ref: docs/scenarios/06-credential-compromise/investigation.md, docs/reference/escalation-triggers.md

// REPLACE: incident time (T0, UTC) on the next line before running
let T0 = datetime(PASTE_TIME_UTC);
let ProcessHits = DeviceProcessEvents
| where Timestamp between ((T0 - 24h) .. (T0 + 24h))
| where DeviceName startswith "HOSTNAME"
| extend Hit = case(
    ProcessCommandLine has "comsvcs" and ProcessCommandLine matches regex @"(?i)MiniDump|#[+-]?\d+",
        "comsvcs MiniDump",
    ProcessCommandLine has "lsass" and ProcessCommandLine matches regex @"(?i)procdump|createdump|sqldumper|nanodump|dumpert|Out-Minidump",
        "lsass dump tool",
    FileName in~ ("procdump.exe", "procdump64.exe", "createdump.exe", "sqldumper.exe") and ProcessCommandLine has "-ma",
        "Full memory dump tool",
    ProcessCommandLine has "ntdsutil" and ProcessCommandLine has_any ("ifm", "create full", "snapshot"),
        "ntdsutil IFM / snapshot",
    FileName =~ "esentutl.exe" and ProcessCommandLine matches regex @"(?i)/vss|\s/y\s|ntds",
        "esentutl copy of locked database",
    (FileName =~ "vssadmin.exe" and ProcessCommandLine has "create" and ProcessCommandLine has "shadow")
        or (FileName =~ "wmic.exe" and ProcessCommandLine has "shadowcopy" and ProcessCommandLine has "create")
        or (FileName =~ "diskshadow.exe" and ProcessCommandLine matches regex @"(?i)\s[/-]s\s|exec"),
        "Shadow copy created",
    ProcessCommandLine has "GLOBALROOT" or ProcessCommandLine contains "HarddiskVolumeShadowCopy",
        "Copy from shadow copy device path",
    ProcessCommandLine has_any ("secretsdump", "Invoke-NinjaCopy", "Invoke-DCSync"),
        "Known dumping tooling",
    "")
| where Hit != ""
| project Timestamp, Source = "Process", Category = Hit, DeviceName, AccountName,
    Process = FileName, Detail = ProcessCommandLine, Parent = InitiatingProcessFileName;
let FileHits = DeviceFileEvents
| where Timestamp between ((T0 - 24h) .. (T0 + 24h))
| where DeviceName startswith "HOSTNAME"
| where ActionType in ("FileCreated", "FileRenamed")
| extend Hit = case(
    FileName contains "lsass" and FileName endswith ".dmp",
        "lsass dump file",
    FileName =~ "ntds.dit" and FolderPath !has "\\Windows\\NTDS",
        "ntds.dit outside the NTDS folder (includes ntdsutil IFM output)",
    FileName in~ ("SAM", "SYSTEM", "SECURITY") and FolderPath !has "\\System32\\config" and FolderPath !has "\\RegBack",
        "Registry hive copy",
    FileName endswith ".dmp" and FolderPath has_any ("\\AppData\\", "\\Temp\\", "\\Users\\Public\\", "\\ProgramData\\", "\\Downloads\\"),
        "Memory dump in user-writable path",
    "")
| where Hit != ""
| project Timestamp, Source = "File", Category = Hit, DeviceName,
    AccountName = InitiatingProcessAccountName, Process = InitiatingProcessFileName,
    Detail = strcat(FolderPath, " | SHA1 ", SHA1, " | ", InitiatingProcessCommandLine),
    Parent = InitiatingProcessParentFileName;
union ProcessHits, FileHits
| order by Timestamp asc
