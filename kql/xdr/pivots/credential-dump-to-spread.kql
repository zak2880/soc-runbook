// Platform: Microsoft Defender XDR Advanced Hunting
// Pivot — credential dump to lateral spread timeline
// Starts from an lsass access event on a device, checks for corroborating credential-
// dumping artefacts (SAM/SYSTEM/SECURITY hive saves, NTDS.dit access, comsvcs
// MiniDump), then checks whether any account seen on that device shows up on a
// DIFFERENT device within 2 hours of the dump — the tight window is deliberate,
// since dumped credentials get used fast or not at all
// Chains: credential access (DeviceEvents, DeviceProcessEvents) -> identity
// (DeviceLogonEvents, patient-zero device) -> identity again (DeviceLogonEvents,
// estate-wide) for the spread check
// Any hit on Stage 2 (credential artefact) or Stage 3 (spread within 2h) = escalate
// immediately, this is not a false-positive-prone pattern
// Ref: docs/scenarios/06-credential-compromise/investigation.md

let target_device = "HOSTNAME";
let dump_lookback = 24h;      // how far back to search for the initial lsass access
let spread_window = 2h;       // how long after the dump to check for account reuse

let LsassAccess = DeviceEvents
| where DeviceName == target_device
| where ActionType == "OpenProcessApiCall"
| where AdditionalFields has "lsass"
| where Timestamp > ago(dump_lookback)
| project DumpTime = Timestamp, DeviceName, InitiatingProcessFileName,
    InitiatingProcessCommandLine;
let T0 = toscalar(LsassAccess | summarize min(DumpTime));
let CredentialArtefacts = DeviceProcessEvents
| where DeviceName == target_device
| where Timestamp > T0
| where ProcessCommandLine has_any (
    "reg save HKLM\\SAM", "reg save HKLM\\SYSTEM", "reg save HKLM\\SECURITY",
    "ntdsutil", "ntds.dit", "comsvcs", "MiniDump")
| project Timestamp, ProcessCommandLine, InitiatingProcessFileName;
let AccountsOnDumpDevice = DeviceLogonEvents
| where DeviceName == target_device
| where Timestamp > T0
| summarize by AccountName;
let SpreadToOtherDevices = DeviceLogonEvents
| where Timestamp between (T0 .. (T0 + spread_window))
| where DeviceName != target_device
| where AccountName in ((AccountsOnDumpDevice))
| project Timestamp, DeviceName, AccountName, LogonType;
union
    (LsassAccess | extend Stage = "1-LsassAccess", TimelineTime = DumpTime),
    (CredentialArtefacts | extend Stage = "2-CredentialArtefact", TimelineTime = Timestamp),
    (SpreadToOtherDevices | extend Stage = "3-AccountSpreadWithin2h", TimelineTime = Timestamp)
| order by TimelineTime asc
