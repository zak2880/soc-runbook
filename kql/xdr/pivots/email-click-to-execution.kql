// Platform: Microsoft Defender XDR Advanced Hunting
// Pivot — malicious URL click to on-device execution
// Starts from a Safe Links click-through (user bypassed the warning), finds which
// device made the resulting outbound connection, then checks for any process
// execution on that device in the following 10 minutes — the sequence you'd expect
// from a drive-by download or a fake-update / ClickFix-style page
// Chains: email/URL (UrlClickEvents) -> network (DeviceNetworkEvents) -> process
// (DeviceProcessEvents)
// Device correlation is by matching RemoteUrl to the clicked URL plus a loose
// account-name match (UPN prefix vs SamAccountName) — if your tenant's UPNs don't
// map cleanly to SamAccountName, this join may under-match; fall back to matching
// on RemoteUrl + time window alone and manually confirming the account
// Ref: docs/scenarios/12-phishing-email/investigation.md, docs/scenarios/10-initial-access/investigation.md

let lookback = 7d;
let target_domain = "SUSPICIOUS_DOMAIN_HERE";   // set to "*" to match any clicked-through URL
let execution_window = 10m;

let ClickedThrough = UrlClickEvents
| where Timestamp > ago(lookback)
| where IsClickedThrough == true
| where target_domain == "*" or Url has target_domain
| project ClickTime = Timestamp, AccountUpn, Url, IPAddress, ActionType;
let DeviceFromConnection = DeviceNetworkEvents
| where Timestamp > ago(lookback)
| join kind=inner ClickedThrough on $left.RemoteUrl == $right.Url
| where Timestamp between (ClickTime .. (ClickTime + execution_window))
| where InitiatingProcessAccountName =~ tostring(split(AccountUpn, "@")[0])
| project ConnTime = Timestamp, DeviceName, RemoteUrl, RemoteIP,
    InitiatingProcessFileName, AccountUpn, ClickTime, Url;
let ExecutionAfterConnection = DeviceProcessEvents
| where Timestamp > ago(lookback)
| join kind=inner DeviceFromConnection on DeviceName
| where Timestamp between (ConnTime .. (ConnTime + execution_window))
| project ExecTime = Timestamp, DeviceName, FileName, ProcessCommandLine,
    InitiatingProcessFileName, ConnTime, ClickTime, Url;
union
    (ClickedThrough | extend Stage = "1-URLClickedThrough", TimelineTime = ClickTime),
    (DeviceFromConnection | extend Stage = "2-DeviceConnected", TimelineTime = ConnTime),
    (ExecutionAfterConnection | extend Stage = "3-ProcessExecuted", TimelineTime = ExecTime)
| order by TimelineTime asc
