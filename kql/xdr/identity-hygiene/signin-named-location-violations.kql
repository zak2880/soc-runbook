// Platform: Microsoft Defender XDR Advanced Hunting
// Identity hygiene — successful sign-ins outside expected named locations (EntraIdSignInEvents)
// Conditional Access "named locations" (trusted IP ranges, countries) are meant to
// restrict where certain access is allowed from — but a misconfigured or
// incompletely-scoped policy can let a sign-in through successfully even from an
// untrusted location, e.g. if the policy targets one app but not another, or a
// location range was never actually attached to the relevant CA policy
// NetworkLocationDetails is where Entra ID surfaces which named location(s), if any,
// matched the sign-in; an empty value on a successful sign-in means no named
// location was recognised for that request at all — worth checking whether that's
// expected for this app/account or a coverage gap
// Sentinel watchlists aren't available in Advanced Hunting — if you need a trusted-
// IP allowlist here, maintain it as a dynamic() array in a shared fn-* function
// under kql/xdr/functions/ and filter against it directly, or cross-reference
// results manually against your documented trusted IP ranges
// Ref: docs/scenarios/06-credential-compromise/investigation.md

let lookback = 24h;
EntraIdSignInEvents
| where Timestamp > ago(lookback)
| where ErrorCode == 0
| where isempty(NetworkLocationDetails) or NetworkLocationDetails == "[]"
| project Timestamp, AccountUpn, IPAddress, Country, AppDisplayName,
    NetworkLocationDetails, ConditionalAccessStatus
| order by Timestamp desc

// ─────────────────────────────────────────────────────────────
