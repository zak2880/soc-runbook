// Platform: Microsoft Defender XDR Advanced Hunting
// Identity hygiene — password reset events (CloudAppEvents)
// Distinguishes self-service resets (a user resetting their own password) from
// admin-initiated resets (an admin or application resets someone else's password) —
// the two carry very different risk profiles. A user resetting their own password
// is routine; an admin account resetting many other accounts' passwords in a short
// window is a classic post-compromise move to lock the real owners out, or to reset
// a target account to a known password
// JUDGEMENT CALL — unverified against a live tenant: ActionType values below use
// the trailing-period form this repo's other CloudAppEvents queries use for Entra
// directory-audit-style operations (compare "Consent to application." in
// entra-post-compromise-oauth-grants.kql) — confirm the exact strings against a
// real event before relying on this in production. The target-account extraction
// from RawEventData.Target[0].ID is also a best-effort guess at the MDCA payload
// shape, not a confirmed schema
// Flags: volume anomalies (5+ resets by one initiator in an hour), resets of
// privileged accounts, resets performed outside business hours
// Ref: docs/scenarios/06-credential-compromise/investigation.md

let lookback = 24h;
let volume_threshold = 5;
let business_hours_start = 7;
let business_hours_end = 19;
CloudAppEvents
| where Timestamp > ago(lookback)
| where ActionType in ("Reset password.", "Reset user password.", "Change password.")
| extend RawData = parse_json(RawEventData)
| extend TargetUpn = tostring(RawData.Target[0].ID)
| extend IsSelfService = AccountId =~ TargetUpn
| extend HourUTC = hourofday(Timestamp)
| extend OutsideBusinessHours = HourUTC !between (business_hours_start .. business_hours_end)
| summarize
    ResetCount = count(),
    Targets = make_set(TargetUpn),
    AnyOutsideBusinessHours = max(OutsideBusinessHours)
    by AccountId, IsSelfService, bin(Timestamp, 1h)
| extend VolumeAnomaly = ResetCount >= volume_threshold
| order by ResetCount desc

