// Platform: Microsoft Defender XDR Advanced Hunting
// Identity hygiene — guest account sign-in activity (EntraIdSignInEvents)
// Guest accounts (AccountUpn containing #EXT#, or IsGuestUser == true) are external
// identities with a foothold in the tenant — they don't show up in normal employee
// account reviews and are a common target for review because their access is easy
// to grant and easy to forget about
// Three prioritisation flags on the full guest sign-in result set, not filters —
// guest activity is already a narrow enough signal to warrant reviewing all of it,
// not just the flagged rows:
//   - OutsideBusinessHours — sign-in outside 07:00-19:00 UTC (adjust for timezone)
//   - NewCountry           — first sign-in from this account from this country in
//                            the prior 30 days
//   - HighVolume           — 20+ sign-ins from the same guest account in the window
// Ref: docs/scenarios/06-credential-compromise/investigation.md

let lookback = 24h;
let baseline_lookback = 30d;
let business_hours_start = 7;
let business_hours_end = 19;
let high_volume_threshold = 20;
let KnownCountries = EntraIdSignInEvents
| where Timestamp between (ago(baseline_lookback + lookback) .. ago(lookback))
| where AccountUpn has "#EXT#" or IsGuestUser == true
| summarize by AccountUpn, Country;
EntraIdSignInEvents
| where Timestamp > ago(lookback)
| where AccountUpn has "#EXT#" or IsGuestUser == true
| extend HourUTC = hourofday(Timestamp)
| extend OutsideBusinessHours = HourUTC !between (business_hours_start .. business_hours_end)
| join kind=leftouter KnownCountries on AccountUpn, Country
| extend NewCountry = isnull(Country1)
| summarize
    SignInCount = count(),
    Apps = make_set(AppDisplayName),
    AnyOutsideBusinessHours = max(OutsideBusinessHours),
    AnyNewCountry = max(NewCountry)
    by AccountUpn, IPAddress, Country, AppDisplayName
| extend HighVolume = SignInCount >= high_volume_threshold
| order by SignInCount desc

// ─────────────────────────────────────────────────────────────
