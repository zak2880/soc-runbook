// Platform: Microsoft Defender XDR Advanced Hunting
// Identity hygiene — anonymous ("anyone with the link") sharing link creation (CloudAppEvents)
// Anonymous links have no recipient restriction at all — anyone who obtains the URL
// (forwarded, pasted somewhere public, guessed) gets access, with no sign-in and no
// audit trail of WHO actually used it beyond the original creation event. That's a
// meaningfully different risk profile from a named-recipient share, which is why
// this query flags every occurrence rather than applying a volume or domain filter
// like office-external-sharing.kql does
// AnonymousLinkCreated/AnonymousLinkUpdated match the exact ActionType strings this
// repo already uses in entra-post-compromise-sharepoint-access.kql
// This should ideally be prevented, not just detected — if the customer's
// SharePoint/OneDrive sharing policy still permits "Anyone" links tenant-wide,
// that's a policy gap worth raising independently of any specific event this query
// surfaces; detection here is a backstop for exceptions, not a substitute for the
// control itself
// Ref: docs/scenarios/06-credential-compromise/investigation.md

let lookback = 24h;
CloudAppEvents
| where Timestamp > ago(lookback)
| where ActionType in ("AnonymousLinkCreated", "AnonymousLinkUpdated")
| summarize
    LinkCount = count(),
    Files = make_set(ObjectId, 10)
    by AccountId, ObjectId, IPAddress
| order by LinkCount desc

