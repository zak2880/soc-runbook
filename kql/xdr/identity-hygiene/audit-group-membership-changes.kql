// Platform: Microsoft Defender XDR Advanced Hunting
// Identity hygiene — security group and distribution list membership changes (CloudAppEvents)
// Group membership is often the actual access-control mechanism, even when the
// directory role model looks locked down — a group that's granted admin rights
// over an application, or that controls access to a sensitive SharePoint site or
// distribution list, is just as valuable a target as a directly-assigned role, and
// is watched less closely by most tenants
// JUDGEMENT CALL — unverified against a live tenant: ActionType values use the
// trailing-period form established elsewhere in this repo's CloudAppEvents queries;
// the group name and member parsed from RawEventData are best-effort guesses at the
// MDCA payload shape — confirm against a real event
// privileged_group_names is a placeholder — populate it with the customer's actual
// group names for their Global Admins/Security Admins/Domain Admins equivalents
// Flags: additions to privileged_group_names, bulk additions (5+ members added to
// the same group in an hour)
// Ref: docs/scenarios/06-credential-compromise/investigation.md

let lookback = 24h;
let bulk_window = 1h;
let bulk_threshold = 5;
let privileged_group_names = dynamic(["Global Admins", "Security Admins", "Domain Admins"]);   // replace with the customer's actual group names
CloudAppEvents
| where Timestamp > ago(lookback)
| where ActionType in ("Add member to group.", "Remove member from group.")
| extend RawData = parse_json(RawEventData)
| extend GroupName = tostring(RawData.Target[0].ID), MemberAdded = tostring(RawData.ModifiedProperties[0].NewValue)
| extend IsPrivilegedGroup = GroupName in (privileged_group_names)
| summarize
    ChangeCount = count(),
    Members = make_set(MemberAdded),
    AnyPrivilegedGroup = max(IsPrivilegedGroup)
    by AccountId, GroupName, ActionType, bin(Timestamp, bulk_window)
| extend BulkChange = ChangeCount >= bulk_threshold
| order by ChangeCount desc

