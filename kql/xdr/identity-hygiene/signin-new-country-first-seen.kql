// Platform: Microsoft Defender XDR Advanced Hunting
// Identity hygiene — first-ever sign-in from a new country (EntraIdSignInEvents)
// Different from impossible travel: impossible travel flags two sign-ins that are
// PHYSICALLY impossible within the observed time gap between them; this flags an
// account using a country it has simply never used before, regardless of whether
// the timing between sign-ins is physically plausible. A slow, patient account
// takeover — sign in once from a new country, then nothing else unusual for days —
// never trips impossible travel, but trips this on the very first sign-in
// Baseline: successful sign-ins over the prior 90 days per account, collapsed to a
// set of known countries with make_set; a country appearing in the last 24h that
// isn't in that set is "new". arg_min pulls the earliest new-country sign-in per
// account in the flagged window, so repeated hits for the same account collapse to
// one row showing when the pattern started
// Ref: docs/scenarios/06-credential-compromise/investigation.md

let lookback = 24h;
let baseline_window = 90d;
let Baseline = EntraIdSignInEvents
| where Timestamp between (ago(baseline_window + lookback) .. ago(lookback))
| where ErrorCode == 0
| summarize KnownCountries = make_set(Country) by AccountUpn;
EntraIdSignInEvents
| where Timestamp > ago(lookback)
| where ErrorCode == 0
| join kind=inner Baseline on AccountUpn
| where Country !in (KnownCountries)
| summarize arg_min(Timestamp, IPAddress, Country), SignInCount = count() by AccountUpn, KnownCountries
| order by Timestamp asc

