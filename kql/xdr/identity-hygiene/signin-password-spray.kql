// Platform: Microsoft Defender XDR Advanced Hunting
// Identity hygiene — password spray detection (EntraIdSignInEvents)
// Password spray inverts brute force: instead of trying many passwords against one
// account (which trips account lockout fast), the attacker tries one or a few
// common passwords against MANY accounts, staying under each account's individual
// lockout threshold while still getting hits across a large enough population
// Two independent signals, both keyed on source IP within a 10-minute window:
//   1. DistinctAccounts > 10 and FailedAttempts > 20 — the core spray signature:
//      one IP failing sign-in against a wide spread of different accounts
//   2. SharedUserAgent — the same UserAgent string used against many distinct
//      accounts; spray tooling often hardcodes one UserAgent rather than rotating
//      it the way a real browser fleet naturally would
// Ref: docs/scenarios/06-credential-compromise/investigation.md, docs/reference/escalation-triggers.md

let lookback = 24h;
let window = 10m;
let account_threshold = 10;
let failure_threshold = 20;
let SprayByVolume = EntraIdSignInEvents
| where Timestamp > ago(lookback)
| where ErrorCode != 0
| summarize
    DistinctAccounts = dcount(AccountUpn),
    FailedAttempts = count(),
    Accounts = make_set(AccountUpn, 20)
    by IPAddress, bin(Timestamp, window)
| where DistinctAccounts > account_threshold and FailedAttempts > failure_threshold
| extend Reason = "High distinct-account failure volume from one IP";
let SprayBySharedUserAgent = EntraIdSignInEvents
| where Timestamp > ago(lookback)
| where ErrorCode != 0
| summarize
    DistinctAccounts = dcount(AccountUpn),
    FailedAttempts = count(),
    Accounts = make_set(AccountUpn, 20)
    by IPAddress, UserAgent, bin(Timestamp, window)
| where DistinctAccounts > account_threshold
| extend Reason = "Same UserAgent used against many distinct accounts";
union SprayByVolume, SprayBySharedUserAgent
| order by DistinctAccounts desc

