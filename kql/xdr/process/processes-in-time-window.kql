// Platform: Microsoft Defender XDR Advanced Hunting
// All process events on a device within a specific time window
// Use to reconstruct execution chain around a detection timestamp
// Replace HOSTNAME, start and end datetime before running
// Ref: docs/scenarios/01-malware-alert/investigation.md

let target_device = "HOSTNAME";                     // replace before running
let start_time = datetime(2024-01-01T10:00);        // replace with window start
let end_time = datetime(2024-01-01T11:00);          // replace with window end
DeviceProcessEvents
| where DeviceName == target_device
| where Timestamp between (start_time .. end_time)
| project Timestamp, InitiatingProcessFileName, FileName,
    ProcessCommandLine, FolderPath, AccountName
| order by Timestamp asc
