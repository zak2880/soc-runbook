// Platform: Microsoft Defender XDR Advanced Hunting
// Note: DeviceAlertEvents may require the Microsoft Defender XDR connector in Sentinel.
// (This table is native to Advanced Hunting; if you're pasting this into a Sentinel
// workspace instead, see kql/sentinel/identity/all-alerts-for-device.kql, which
// documents why that table isn't queryable there today.)
// Identity / triage — all Defender alerts for a specific device
// Use at the start of any investigation to get the full picture before drilling into logs
// Replace HOSTNAME before running
// Ref: docs/scenarios/01-malware-alert/investigation.md

let target_device = "HOSTNAME";   // replace before running
let lookback = 7d;
DeviceAlertEvents
| where DeviceName == target_device
| where Timestamp > ago(lookback)
| project Timestamp, AlertId, Title, Severity
| order by Timestamp desc

