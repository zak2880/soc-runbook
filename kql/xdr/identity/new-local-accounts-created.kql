// Platform: Microsoft Defender XDR Advanced Hunting
// Identity — new local user accounts created on a device
// Malware may create backdoor local admin accounts to maintain access after cleanup
// Also check for accounts added to the local Administrators group
// Ref: docs/scenarios/06-credential-compromise/investigation.md

let target_device = "HOSTNAME";   // replace before running
let lookback = 7d;
DeviceEvents
| where DeviceName == target_device
| where ActionType == "UserAccountCreated"
| where Timestamp > ago(lookback)
| project Timestamp, AccountName, InitiatingProcessFileName,
    InitiatingProcessCommandLine

